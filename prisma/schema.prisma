// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---- Admin / Authentication ----
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("admin") // admin | operator
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- School Profile (single record, identified by singleton key) ----
model SchoolProfile {
  id                 String   @id @default(cuid())
  name               String
  npsn               String?
  nss                String?
  accreditation      String?
  address            String
  village            String
  district           String
  regency            String
  province           String
  postalCode         String?
  phone              String?
  email              String?
  whatsapp           String?
  facebook           String?
  instagram          String?
  youtube            String?
  tiktok             String?
  logo               String?
  vision             String
  mission            String
  goals              String
  history            String
  headmasterName     String
  headmasterPhoto   String?
  headmasterWelcome  String
  headmasterNip      String?
  mapEmbed           String?
  serviceHours       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ---- Teachers & Staff (GTK) ----
model Teacher {
  id          String   @id @default(cuid())
  name        String
  photo       String?
  nip         String?
  nuptk       String?
  birthDate   String?
  position    String
  education   String
  subject     String?
  category    String   @default("Guru")
  gender      String   @default("L")
  phone       String?
  email       String?
  bio         String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- Students (no sensitive data exposed publicly) ----
model Student {
  id            String   @id @default(cuid())
  nisn          String?
  nis           String?
  name          String
  photo         String?
  birthDate     String?
  gender        String   // L | P
  className     String   // 1 .. 6
  academicYear  String   // 2024/2025
  status        String   @default("Aktif")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---- Facilities (Sarpras) ----
model Facility {
  id          String   @id @default(cuid())
  name        String
  photo       String?
  category    String   // Ruang Kelas | Ruang Guru | ...
  quantity    Int      @default(1)
  condition   String   @default("Baik") // Baik | Rusak Ringan | Rusak Berat
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- Gallery ----
model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  photo       String
  altText     String?
  category    String   // Kegiatan Pembelajaran | Upacara | ...
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- News (Berita) ----
model News {
  id          String   @id @default(cuid())
  title       String
  excerpt     String?
  content     String
  photo       String?
  photoAltText String?
  category    String   @default("Umum")
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- Announcements (Pengumuman) ----
model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  photo       String?
  date        DateTime @default(now())
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- Contact Messages (from contact form) ----
model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  subject     String
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- File Uploads (stored as base64 in database for Vercel serverless) ----
model FileUpload {
  id          String   @id @default(cuid())
  data        String
  contentType String   @default("image/jpeg")
  filename    String?
  size        Int      @default(0)
  createdAt   DateTime @default(now())
}

// ---- PPDB Schedule ----
model PpdbSchedule {
  id          String   @id @default(cuid())
  phase       String
  date        String
  time        String
  description String?
  status      String   @default("upcoming")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- PPDB Announcements (with file attachments) ----
model PpdbAnnouncement {
  id          String   @id @default(cuid())
  title       String
  content     String
  photo       String?
  fileUrl     String?
  fileName    String?
  fileType    String?
  date        DateTime @default(now())
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- PPDB Requirements (editable by admin) ----
model PpdbRequirement {
  id          String   @id @default(cuid())
  title       String
  description String?
  required    Boolean  @default(true)
  allowUpload Boolean  @default(true)
  order       Int      @default(0)
  documents  PpdbDocument[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- PPDB Registrations (visitor submissions) ----
model PpdbRegistration {
  id          String   @id @default(cuid())
  childName   String
  birthPlace  String?
  birthDate   String?
  parentName  String
  parentPhone String
  parentEmail String?
  address     String?
  notes       String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  documents   PpdbDocument[]
}

// ---- PPDB Documents (uploaded files per requirement) ----
model PpdbDocument {
  id            String   @id @default(cuid())
  registrationId String
  requirementId String
  fileName      String
  fileId        String
  fileType      String
  fileSize      Int
  uploadedAt    DateTime @default(now())
  registration  PpdbRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  requirement   PpdbRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
}

// ---- Homepage Statistics ----
model Statistic {
  id          String   @id @default(cuid())
  label       String
  value       Int
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- Hero Photos (moving carousel on Beranda) ----
model HeroPhoto {
  id        String   @id @default(cuid())
  src       String   // photo URL or path (e.g. /uploads/hero-signboard.jpg)
  alt       String   // caption shown on the carousel
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- Organization Structure ----
model OrganizationMember {
  id          String   @id @default(cuid())
  name        String
  position    String
  photo       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
